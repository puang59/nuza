{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nuza",
  "version": "0.1.6",
  "identifier": "com.puang.nuza",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 27
        },
        "transparent": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://nuza-update.puang.in/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNjgzM0RBMzIyQTdDQUIKUldTcmZDb3kyak5vdW1JZGxQMGtkb2RrNHRNRmFPSUpkSU1xdHRCNlM3Rm43TXBCM1pwaVh5VFgK"
    }
  }
}
